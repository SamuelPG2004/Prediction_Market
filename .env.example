# Copia este archivo a `.env.local` y rellena los valores. Nunca commitees
# un .env real: .gitignore ya los excluye.

# --- Azuro (deportes, Polygon por defecto) ----------------------------------

# Cadena de Azuro. Opcional; por defecto 137 (Polygon).
# Soportadas: 137 (Polygon), 8453 (Base), 80002 (Amoy), 84532 (Base Sepolia).
VITE_AZURO_CHAIN_ID=137

# Dirección de afiliado que viaja en cada apuesta (recibe las recompensas de
# frontend del protocolo). Sin ella la app lista y cotiza, pero no puede
# colocar apuestas (`canPlaceBet: false`).
VITE_AZURO_AFFILIATE_ADDRESS=

# --- Limitless (no deportes, Base) -------------------------------------------

# Token API con alcance `trading`, derivado en limitless.exchange → API Tokens.
# El secreto llega en base64 y solo se muestra una vez. Sin estas dos variables
# la app lista y cotiza mercados de Limitless, pero no puede colocar órdenes ni
# leer posiciones (`canPlaceBet` y `canReadPositions` en false).
#
# ⚠️ SOLO PARA LOCAL: todo lo VITE_ acaba en el bundle JS que descarga
# cualquier visitante. En un deploy público (Vercel) deja estas dos vacías y
# usa VITE_LIMITLESS_AUTH_MODE=proxy (abajo).
VITE_LIMITLESS_API_TOKEN_ID=
VITE_LIMITLESS_API_TOKEN_SECRET=

# 'proxy': la firma HMAC la pone la función serverless api/limitless, que lee
# LIMITLESS_API_TOKEN_ID y LIMITLESS_API_TOKEN_SECRET (SIN prefijo VITE_,
# variables de servidor en Vercel) y el secreto nunca llega al navegador.
# Excluyente con las credenciales VITE_ de arriba. En dev local no aplica:
# el proxy de Vite no firma.
VITE_LIMITLESS_AUTH_MODE=

# Limitless también publica deportes, pero el plan de venues los asigna a
# Azuro; pon 'true' solo si quieres listarlos también desde Limitless.
VITE_LIMITLESS_INCLUDE_SPORTS=

# La API de Limitless tiene allowlist de CORS: el navegador pasa por el proxy
# same-origin /api/limitless (ya configurado en vite.config.ts para dev y
# preview). En Vercel lo cubre la función serverless api/limitless; en otro
# host, reenvía /api/limitless/* hacia https://api.limitless.exchange. Solo
# cambia esto si usas otra ruta/pasarela.
VITE_LIMITLESS_API_URL=

# --- WalletConnect (opcional) --------------------------------------------------

# Habilita conectar wallets MÓVILES por QR (app de Binance, Trust, etc.).
# Crea un projectId gratuito en https://cloud.reown.com y pégalo aquí.
# Sin él, solo se ofrecen las wallets de extensión del navegador.
VITE_WALLETCONNECT_PROJECT_ID=

# --- RPCs (opcionales) --------------------------------------------------------

# Endpoints propios con clave (Alchemy/Infura/dRPC). Si se definen, van
# primero en el fallback; los públicos de respaldo viven en src/config/chains.ts.
VITE_POLYGON_RPC_URL=
VITE_BASE_RPC_URL=
